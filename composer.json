{
  "name": "laragod/dice-system",
  "description": "Deterministic-ish dice rollers for game variants (deck-based 2d6, etc.)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.10",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "Laragod\\DiceSystem\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Laragod\\DiceSystem\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html build/coverage --coverage-text",
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs --standard=PSR12 src tests",
    "phpcbf": "phpcbf --standard=PSR12 src tests",
    "rector": "rector process --dry-run",
    "rector-fix": "rector process",
    "quality": [
      "@phpstan",
      "@phpcs",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Laragod\\DiceSystem\\Laravel\\DiceSystemServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
